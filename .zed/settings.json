{
  "autosave": {
    "after_delay": {
      "milliseconds": 1000
    }
  },
  "format_on_save": "on",
  "tab_size": 4,
  "hard_tabs": false,
  "show_whitespaces": "boundary",
  "ensure_final_newline_on_save": true,
  "remove_trailing_whitespace_on_save": true,
  "languages": {
    "C": {
      "tab_size": 4,
      "format_on_save": "on"
    },
    "C++": {
      "tab_size": 4,
      "format_on_save": "on"
    },
    "Markdown": {
      "format_on_save": "off",
      "remove_trailing_whitespace_on_save": false
    }
  },
  "lsp": {
    "clangd": {
      "binary": {
        "arguments": [
          "--background-index",
          "--compile-commands-dir=.",
          "--header-insertion=never",
          "--completion-style=detailed"
        ]
      }
    }
  }
}
